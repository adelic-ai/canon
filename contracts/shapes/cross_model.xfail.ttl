# XFAIL — a sigma_corroboration activity that claims corroboration but is NOT backed by any sigma-rule
# witness it used. Corroboration asserted, not earned → must FAIL the shape.
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix canon: <urn:canon:prov#> .
@prefix op:    <urn:canon:op#> .

<urn:canon:activity:xfail> a prov:Activity , op:sigma_corroboration ;   # dual-typed by its op
    prov:used <urn:canon:entity:detection_xfail> .   # only the detection — NO sigma-rule witness
